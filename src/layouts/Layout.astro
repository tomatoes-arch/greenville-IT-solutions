---
const { title = 'Greenville IT Solutions', description = 'Digital products, websites, and Android apps for ambitious organizations.' } = Astro.props;
const path = Astro.url.pathname;
---
<!doctype html>
<html lang="en">
	<head>
		<meta charset="UTF-8" />
		<meta name="viewport" content="width=device-width" />
		<meta name="description" content={description} />
		<meta name="theme-color" content="#112b25" />
		<title>{title}</title>
		<style is:global>
			@import url('https://fonts.googleapis.com/css2?family=DM+Sans:wght@400;500;600;700&family=Space+Grotesk:wght@500;600;700&display=swap');
			:root { --ink:#112b25; --muted:#5a6c65; --paper:#f5f7f2; --soft:#e6eee6; --line:#d6e1d9; --green:#217758; --lime:#d5ef61; --orange:#ef7148; }
			* { box-sizing:border-box; } html { scroll-behavior:smooth; } body { margin:0; color:var(--ink); background:var(--paper); font-family:'DM Sans',sans-serif; } a { color:inherit; text-decoration:none; } img { display:block; max-width:100%; }
			.container { width:min(1160px,calc(100% - 48px)); margin:auto; } .eyebrow { color:var(--green); font-size:.72rem; font-weight:700; letter-spacing:.14em; text-transform:uppercase; } h1,h2,h3 { font-family:'Space Grotesk',sans-serif; letter-spacing:-.06em; } h1,h2,h3,p { margin-top:0; } .button { display:inline-flex; align-items:center; gap:10px; padding:13px 18px; border:1px solid transparent; border-radius:3px; font-size:.82rem; font-weight:700; transition:transform .2s,background .2s; } .button:hover { transform:translateY(-2px); } .button-primary { background:var(--lime); color:var(--ink); } .button-dark { background:var(--ink); color:#fff; } .button-outline { border-color:#6f897c; color:#fff; }
			.site-header { position:absolute; z-index:3; width:100%; color:#fff; } .site-header-light { position:relative; color:#fff; background:var(--ink); } .nav { display:flex; align-items:center; justify-content:space-between; min-height:86px; } .brand { display:flex; align-items:center; gap:10px; font-family:'Space Grotesk',sans-serif; font-weight:700; letter-spacing:-.03em; } .brand-mark { display:inline-block; width:28px; height:28px; border:2px solid var(--lime); border-radius:50%; position:relative; } .brand-mark:after { content:''; position:absolute; width:9px; height:9px; left:7px; top:7px; border-radius:50%; background:var(--lime); } .nav-links { display:flex; align-items:center; gap:28px; color:#c5d5cb; font-size:.84rem; } .nav-links a:hover,.nav-links .active { color:var(--lime); } .nav-cta { border:1px solid #637d70; padding:10px 15px; border-radius:3px; font-size:.8rem; font-weight:700; } .nav-cta:hover { color:var(--lime); } .menu-button { display:none; border:0; background:none; color:#fff; font-size:1.5rem; }
			.hero { min-height:560px; display:flex; align-items:end; padding:150px 0 85px; color:#fff; background:var(--ink); position:relative; overflow:hidden; } .hero:after { content:''; position:absolute; width:530px; height:530px; right:-180px; top:70px; border:1px solid #406457; border-radius:50%; box-shadow:0 0 0 54px #1d3b31,0 0 0 55px #406457,0 0 0 126px #18352c; opacity:.55; } .hero .container { position:relative; z-index:1; } .hero h1 { max-width:780px; margin:16px 0 20px; font-size:clamp(3.3rem,7vw,6.4rem); line-height:.94; } .hero h1 em { color:var(--lime); font-style:normal; } .hero-copy { max-width:560px; color:#bbccc2; font-size:1.05rem; line-height:1.7; } .hero-actions { display:flex; gap:12px; margin-top:30px; }
			main section { padding:104px 0; } .section-head { display:flex; justify-content:space-between; align-items:end; gap:35px; margin-bottom:45px; } .section-head h2 { margin:10px 0 0; font-size:clamp(2.3rem,4vw,4rem); line-height:1; } .section-head > p { max-width:330px; margin:0; color:var(--muted); line-height:1.6; } .intro-grid { display:grid; grid-template-columns:.8fr 1.2fr; gap:100px; } .intro-grid h2 { margin:10px 0 0; font-size:clamp(2.5rem,4vw,4.2rem); line-height:1; } .intro-grid p { max-width:630px; color:var(--muted); font-size:1.08rem; line-height:1.75; } .intro-grid p + p { font-size:.94rem; }
			.soft-section { background:var(--soft); } .service-grid { display:grid; grid-template-columns:repeat(4,1fr); border-top:1px solid #b9cec0; } .service { padding:28px 24px 24px 0; border-bottom:1px solid #b9cec0; } .service + .service { border-left:1px solid #b9cec0; padding-left:24px; } .service-number { color:var(--orange); font-weight:700; font-size:.75rem; } .service h3 { margin:45px 0 12px; font-size:1.4rem; } .service p { color:var(--muted); font-size:.9rem; line-height:1.6; } .tags { display:flex; flex-wrap:wrap; gap:7px; margin-top:22px; } .tag { border:1px solid #b9cec0; padding:6px 8px; color:#48685b; font-size:.7rem; }
			.project-grid { display:grid; grid-template-columns:1.1fr .9fr; gap:24px; } .project-card { position:relative; min-height:370px; overflow:hidden; background:#c6d9c6; } .project-card img { width:100%; height:100%; min-height:370px; object-fit:cover; transition:transform .5s; } .project-card:hover img { transform:scale(1.04); } .project-card:first-child { grid-row:span 2; } .project-card:first-child img { min-height:764px; } .project-overlay { position:absolute; inset:auto 0 0; padding:28px; color:#fff; background:linear-gradient(transparent,rgba(10,35,27,.9)); } .project-overlay h3 { margin:8px 0; font-size:1.8rem; } .project-overlay p { margin:0; color:#d3e2d8; font-size:.88rem; }
			.stats { background:var(--ink); color:#fff; } .stats-grid { display:grid; grid-template-columns:repeat(3,1fr); gap:35px; } .stat strong { display:block; color:var(--lime); font-family:'Space Grotesk',sans-serif; font-size:3rem; letter-spacing:-.07em; } .stat span { color:#b7c9bf; font-size:.88rem; }
			.cta-band { padding:80px 0; background:var(--lime); } .cta-row { display:flex; justify-content:space-between; align-items:center; gap:30px; } .cta-row h2 { max-width:600px; margin:0; font-size:clamp(2.3rem,4vw,4rem); line-height:1; } .cta-row p { max-width:310px; margin:0; color:#496047; line-height:1.6; }
			.page-content { padding-top:140px; } .split-grid { display:grid; grid-template-columns:1fr 1fr; gap:70px; align-items:start; } .copy p { color:var(--muted); line-height:1.75; } .copy h2 { font-size:clamp(2.2rem,4vw,3.7rem); line-height:1; }
			.case-list { display:grid; gap:80px; } .case { display:grid; grid-template-columns:1fr 1fr; gap:40px; align-items:center; } .case:nth-child(even) .case-image { order:2; } .case-image { aspect-ratio:1.25; overflow:hidden; } .case-image img { width:100%; height:100%; object-fit:cover; } .case h2 { margin:12px 0; font-size:2.5rem; } .case p { color:var(--muted); line-height:1.7; } .case-meta { display:flex; gap:8px; flex-wrap:wrap; margin:22px 0; }
			.contact-layout { display:grid; grid-template-columns:.8fr 1.2fr; gap:90px; } .contact-layout h1 { max-width:500px; margin:15px 0 20px; font-size:clamp(3rem,6vw,5.7rem); line-height:.94; } .contact-layout .lead { color:var(--muted); line-height:1.7; } .contact-detail { margin-top:40px; font-size:.9rem; } .contact-detail strong { display:block; margin-bottom:7px; font-size:.7rem; text-transform:uppercase; letter-spacing:.12em; } .contact-form { display:grid; grid-template-columns:1fr 1fr; gap:18px; } .field { display:flex; flex-direction:column; gap:7px; } .field-full { grid-column:1/-1; } label { color:var(--muted); font-size:.75rem; font-weight:700; } input,select,textarea { width:100%; padding:14px; border:1px solid #c4d3c8; border-radius:2px; background:#fff; color:var(--ink); font:inherit; } textarea { min-height:140px; resize:vertical; } input:focus,select:focus,textarea:focus { outline:2px solid var(--lime); border-color:var(--green); } .form-note { display:none; padding:15px; background:var(--soft); color:var(--green); font-size:.9rem; } .form-note.visible { display:block; }
			.site-footer { padding:32px 0; background:#0b1d18; color:#b9c9c0; font-size:.8rem; } .footer-row { display:flex; align-items:center; justify-content:space-between; gap:25px; } .footer-brand { color:#fff; } .footer-links { display:flex; gap:22px; } .footer-links a:hover { color:var(--lime); }
			@media (max-width:760px) { .container { width:min(100% - 36px,600px); } .nav { min-height:72px; } .nav-links,.nav-cta { display:none; } .menu-button { display:block; } .hero { min-height:620px; padding:130px 0 60px; } .hero:after { width:280px; height:280px; right:-145px; top:300px; } .hero h1 { font-size:clamp(3.1rem,16vw,5rem); } .hero-actions,.cta-row { align-items:flex-start; flex-direction:column; } main section { padding:76px 0; } .section-head,.intro-grid,.split-grid,.contact-layout { display:block; } .section-head > p { margin-top:20px; } .intro-grid h2 { margin-bottom:28px; } .service-grid { grid-template-columns:1fr 1fr; } .service + .service { padding-left:16px; } .service:nth-child(odd) { padding-left:0; } .project-grid { grid-template-columns:1fr; } .project-card:first-child,.project-card:first-child img { min-height:360px; } .project-card { min-height:270px; } .project-card img { min-height:270px; } .stats-grid { grid-template-columns:1fr; gap:25px; } .case,.contact-form { grid-template-columns:1fr; } .case:nth-child(even) .case-image { order:0; } .contact-layout > * + * { margin-top:45px; } .field-full { grid-column:auto; } .footer-row { align-items:flex-start; flex-direction:column; } .footer-links { flex-wrap:wrap; } }
		</style>
	</head>
	<body>
		<header class:list={['site-header', { 'site-header-light': path === '/contact/' }]}><div class="container nav"><a class="brand" href="/"><span class="brand-mark" aria-hidden="true"></span>Greenville</a><nav class="nav-links" aria-label="Primary navigation"><a class={path === '/' ? 'active' : ''} href="/">Home</a><a class={path === '/services/' ? 'active' : ''} href="/services/">Services</a><a class={path === '/work/' ? 'active' : ''} href="/work/">Work</a><a class={path === '/about/' ? 'active' : ''} href="/about/">About</a></nav><a class="nav-cta" href="/contact/">Start a project <span aria-hidden="true">↗</span></a><button class="menu-button" aria-label="Open navigation">☰</button></div></header>
		<slot />
		<footer class="site-footer"><div class="container footer-row"><a class="brand footer-brand" href="/"><span class="brand-mark" aria-hidden="true"></span>Greenville</a><span>Digital products for growing organizations.</span><div class="footer-links"><a href="/services/">Services</a><a href="/work/">Work</a><a href="/contact/">Contact</a></div></div></footer>
	</body>
</html>