---
import Layout from '../layouts/Layout.astro';
---
<Layout title="Contact | Greenville IT Solutions" description="Start a web, Android, or digital product project with Greenville.">
	<main><section class="page-content"><div class="container contact-layout"><div><div class="eyebrow">Start a project</div><h1>Tell us what needs building.</h1><p class="lead">A few details are enough for a first conversation. Tell us what you need, who it is for, and where things currently get stuck.</p><div class="contact-detail"><strong>Email</strong><a href="mailto:hello@greenville.co.ke">hello@greenville.co.ke</a></div><div class="contact-detail"><strong>Based in</strong>Juja, Kiambu County, Kenya</div></div><div><form class="contact-form" id="contact-form"><div class="field"><label for="name">Your name</label><input id="name" name="name" autocomplete="name" required /></div><div class="field"><label for="email">Email address</label><input id="email" name="email" type="email" autocomplete="email" required /></div><div class="field"><label for="organization">Company or organization</label><input id="organization" name="organization" autocomplete="organization" /></div><div class="field"><label for="service">What do you need?</label><select id="service" name="service"><option value="">Choose a service</option><option>Website or web application</option><option>Android app</option><option>Product design</option><option>Support and improvement</option><option>Something else</option></select></div><div class="field field-full"><label for="message">Tell us about the project</label><textarea id="message" name="message" required></textarea></div><div class="field field-full"><button class="button button-dark" type="submit">Send project enquiry <span aria-hidden="true">↗</span></button></div></form><p class="form-note" id="form-note" role="status">Thanks. Your message has been noted. We will be in touch at the email you provided.</p></div></div></section></main>
	<script>
		const form = document.querySelector('#contact-form');
		const note = document.querySelector('#form-note');
		form?.addEventListener('submit', (event) => { event.preventDefault(); form.setAttribute('hidden', ''); note?.classList.add('visible'); });
	</script>
</Layout>