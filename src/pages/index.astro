---
const services = [
	{ number: '01', title: 'Web applications', description: 'Custom platforms and internal tools designed around how your organization actually works.', tags: ['Business systems', 'Portals', 'Dashboards'] },
	{ number: '02', title: 'Mobile products', description: 'Android and iOS experiences connected to the services, data, and workflows behind them.', tags: ['Android', 'iOS', 'API integration'] },
	{ number: '03', title: 'Data annotation', description: 'Consistent, quality-controlled labeling workflows for teams preparing data for machine learning.', tags: ['Classification', 'Computer vision', 'Quality control'] },
	{ number: '04', title: 'IT support', description: 'Practical technical support that keeps your people, systems, and customers moving forward.', tags: ['Troubleshooting', 'Maintenance', 'Helpdesk'] },
];
const process = [
	['01', 'Discover', 'We understand the goal, the people involved, and the challenge worth solving.'],
	['02', 'Plan', 'We shape the scope, solution, architecture, and delivery plan together.'],
	['03', 'Build', 'We develop the right product with clear communication at every stage.'],
	['04', 'Support', 'We stay close after launch for maintenance, improvements, and what comes next.'],
];
---

<html lang="en">
	<head>
		<meta charset="utf-8" />
		<meta name="viewport" content="width=device-width" />
		<meta name="description" content="Greenville builds practical software, data, and IT solutions for growing organizations." />
		<meta name="theme-color" content="#10251f" />
		<meta property="og:title" content="Greenville | Technology built around your business" />
		<meta property="og:description" content="Practical software, data, and IT solutions for growing organizations." />
		<meta property="og:type" content="website" />
		<title>Greenville | Technology built around your business</title>
		<style>
			@import url('https://fonts.googleapis.com/css2?family=DM+Sans:wght@400;500;600;700&family=Space+Grotesk:wght@500;600;700&display=swap');
			:root { --ink:#10251f; --muted:#5b6b65; --paper:#f5f7f2; --line:#dbe4dd; --green:#1d7657; --lime:#d4f05c; --orange:#f4774b; }
			* { box-sizing:border-box; } html { scroll-behavior:smooth; } body { margin:0; background:var(--paper); color:var(--ink); font-family:'DM Sans',sans-serif; } a { color:inherit; text-decoration:none; }
			.container { width:min(1180px,calc(100% - 48px)); margin:0 auto; } .eyebrow { color:var(--green); font-size:.75rem; font-weight:700; letter-spacing:.13em; text-transform:uppercase; }
			.site-header { position:absolute; z-index:2; top:0; width:100%; color:#f7faf4; } .nav { display:flex; align-items:center; justify-content:space-between; min-height:88px; } .brand { display:flex; align-items:center; gap:11px; font-family:'Space Grotesk',sans-serif; font-size:1.1rem; font-weight:700; letter-spacing:-.03em; } .brand-mark { width:29px; height:29px; position:relative; display:inline-block; border:2px solid var(--lime); border-radius:50%; } .brand-mark::after { content:''; position:absolute; width:10px; height:10px; left:7px; top:7px; border-radius:50%; background:var(--lime); } .nav-links { display:flex; align-items:center; gap:32px; color:#c5d3ca; font-size:.9rem; } .nav-links a:hover { color:var(--lime); } .nav-cta,.button { display:inline-flex; align-items:center; justify-content:center; gap:10px; border:1px solid transparent; border-radius:3px; padding:14px 20px; font-size:.84rem; font-weight:700; transition:transform .2s,background .2s; } .nav-cta { border-color:#50685d; color:white; padding:11px 16px; } .nav-cta:hover,.button:hover { transform:translateY(-2px); } .menu-button { display:none; color:white; background:none; border:0; font-size:1.4rem; }
			.hero { position:relative; overflow:hidden; min-height:690px; display:flex; align-items:center; padding:140px 0 90px; background:var(--ink); color:white; } .hero::before { content:''; position:absolute; inset:0; opacity:.13; background-image:linear-gradient(#a7c4b3 1px,transparent 1px),linear-gradient(90deg,#a7c4b3 1px,transparent 1px); background-size:72px 72px; mask-image:linear-gradient(90deg,black,transparent 76%); } .hero::after { content:''; position:absolute; width:500px; height:500px; right:-110px; top:85px; border:1px solid #426153; border-radius:50%; box-shadow:0 0 0 52px #203a30,0 0 0 53px #426153,0 0 0 120px #183029,0 0 0 121px #426153; opacity:.55; } .hero-grid { position:relative; z-index:1; display:grid; grid-template-columns:1.05fr .95fr; gap:80px; align-items:center; } .hero h1 { max-width:680px; margin:18px 0 25px; font-family:'Space Grotesk',sans-serif; font-size:clamp(3.4rem,7vw,6.5rem); line-height:.94; letter-spacing:-.065em; } .hero h1 em { color:var(--lime); font-style:normal; } .hero-copy { max-width:500px; color:#bdcdc4; font-size:1.08rem; line-height:1.7; } .hero-actions { display:flex; gap:12px; margin-top:35px; } .button-primary { background:var(--lime); color:var(--ink); } .button-secondary { border-color:#587066; color:white; } .button-secondary:hover { background:#26483b; } .hero-note { display:flex; align-items:center; gap:10px; margin-top:64px; color:#80988b; font-size:.78rem; } .hero-note span { width:7px; height:7px; border-radius:50%; background:var(--orange); }
			.signal { position:relative; z-index:1; margin-top:80px; border-top:1px solid #354e43; border-bottom:1px solid #354e43; } .signal-list { display:grid; grid-template-columns:repeat(4,1fr); } .signal-item { padding:20px 0; color:#c8d6ce; font-size:.84rem; } .signal-item + .signal-item { border-left:1px solid #354e43; padding-left:22px; } main section { padding:120px 0; }
			.intro-grid { display:grid; grid-template-columns:.75fr 1.25fr; gap:100px; } .intro h2,.section-heading h2 { margin:12px 0 0; font-family:'Space Grotesk',sans-serif; font-size:clamp(2.4rem,4vw,4.2rem); line-height:1.02; letter-spacing:-.06em; } .intro p { max-width:580px; margin:0; color:var(--muted); font-size:1.15rem; line-height:1.75; } .intro p + p { margin-top:20px; font-size:.95rem; }
			.services { background:#e8eee8; } .section-heading { display:flex; align-items:end; justify-content:space-between; margin-bottom:54px; } .section-heading p { max-width:300px; margin:0; color:var(--muted); line-height:1.6; } .service-grid { display:grid; grid-template-columns:repeat(2,1fr); border-top:1px solid #bdccc2; } .service { padding:33px 35px 36px 0; border-bottom:1px solid #bdccc2; } .service:nth-child(even) { padding-left:35px; border-left:1px solid #bdccc2; } .service-number { color:var(--orange); font-size:.78rem; font-weight:700; } .service h3 { margin:25px 0 10px; font-family:'Space Grotesk',sans-serif; font-size:1.55rem; letter-spacing:-.04em; } .service p { max-width:460px; margin:0; color:var(--muted); line-height:1.6; } .tags { display:flex; flex-wrap:wrap; gap:8px; margin-top:25px; } .tag { border:1px solid #c0d0c4; padding:7px 10px; color:#416357; font-size:.73rem; }
			.principles { background:var(--ink); color:white; } .principles .eyebrow { color:var(--lime); } .principles-grid { display:grid; grid-template-columns:.7fr 1.3fr; gap:100px; } .principles h2 { max-width:420px; } .principles-list { display:grid; grid-template-columns:repeat(2,1fr); gap:0 45px; } .principle { padding:0 0 28px; margin-bottom:28px; border-bottom:1px solid #385147; } .principle strong { display:block; margin-bottom:10px; color:var(--lime); font-family:'Space Grotesk',sans-serif; font-size:1.15rem; } .principle p { margin:0; color:#b4c6bc; line-height:1.6; font-size:.92rem; }
			.work { background:#f0f3ec; } .work-frame { display:grid; grid-template-columns:1.15fr .85fr; min-height:390px; background:#dce9dc; } .work-art { position:relative; overflow:hidden; background:#bdd7b8; } .work-art::before { content:''; position:absolute; width:330px; height:330px; left:12%; top:10%; border:1px solid #7ea685; border-radius:50%; box-shadow:0 0 0 40px #c7dfc2,0 0 0 41px #7ea685,0 0 0 100px #b3d1ae,0 0 0 101px #7ea685; } .work-art::after { content:'CAPABILITIES'; position:absolute; right:28px; bottom:23px; color:#557e5d; font-size:.73rem; letter-spacing:.16em; writing-mode:vertical-rl; } .work-copy { display:flex; flex-direction:column; justify-content:center; padding:50px; } .work-copy h3 { margin:14px 0; font-family:'Space Grotesk',sans-serif; font-size:2.3rem; letter-spacing:-.05em; } .work-copy p { margin:0; color:var(--muted); line-height:1.65; } .work-link { display:inline-flex; gap:12px; margin-top:35px; color:var(--green); font-size:.85rem; font-weight:700; }
			.process { padding-bottom:130px; } .process-grid { display:grid; grid-template-columns:repeat(4,1fr); gap:25px; } .process-card { padding-top:20px; border-top:2px solid var(--green); } .process-card span { color:var(--orange); font-size:.78rem; font-weight:700; } .process-card h3 { margin:40px 0 12px; font-family:'Space Grotesk',sans-serif; font-size:1.35rem; } .process-card p { margin:0; color:var(--muted); font-size:.9rem; line-height:1.6; }
			.contact { padding:85px 0; background:var(--lime); } .contact-grid { display:grid; grid-template-columns:.85fr 1.15fr; gap:90px; align-items:start; } .contact h2 { max-width:500px; margin:12px 0 20px; font-family:'Space Grotesk',sans-serif; font-size:clamp(2.7rem,5vw,5rem); line-height:.98; letter-spacing:-.065em; } .contact-intro p { max-width:380px; color:#3e5c45; line-height:1.65; } .contact-detail { margin-top:42px; font-size:.9rem; } .contact-detail strong { display:block; margin-bottom:8px; font-size:.75rem; letter-spacing:.12em; text-transform:uppercase; } .contact-form { display:grid; grid-template-columns:1fr 1fr; gap:20px; } .field { display:flex; flex-direction:column; gap:8px; } .field-full { grid-column:1 / -1; } .field label { color:#3e5c45; font-size:.76rem; font-weight:700; } .field input,.field select,.field textarea { width:100%; border:1px solid #a8c648; border-radius:2px; padding:14px; background:rgba(255,255,255,.42); color:var(--ink); font:inherit; outline:none; } .field input:focus,.field select:focus,.field textarea:focus { border-color:var(--ink); box-shadow:0 0 0 2px rgba(16,37,31,.12); } .field textarea { min-height:120px; resize:vertical; } .form-submit { margin-top:4px; background:var(--ink); color:white; cursor:pointer; } .form-submit:hover { background:var(--green); }
			.site-footer { padding:32px 0; background:#0b1b17; color:#b9c9c0; font-size:.8rem; } .footer-row { display:flex; align-items:center; justify-content:space-between; gap:25px; } .footer-brand { color:white; } .footer-links { display:flex; gap:25px; } .footer-links a:hover { color:var(--lime); }
			@media (max-width:760px) { .container { width:min(100% - 36px,600px); } .nav { min-height:72px; } .nav-links,.nav-cta { display:none; } .menu-button { display:block; } .hero { min-height:auto; padding:128px 0 55px; } .hero::after { width:280px; height:280px; right:-150px; top:270px; opacity:.4; } .hero-grid,.intro-grid,.principles-grid,.contact-grid,.work-frame { grid-template-columns:1fr; gap:45px; } .hero h1 { font-size:clamp(3.25rem,16vw,5rem); } .hero-copy { font-size:1rem; } .hero-note { margin-top:35px; } .signal { margin-top:55px; } .signal-list { grid-template-columns:1fr 1fr; } .signal-item:nth-child(3) { border-left:0; padding-left:0; } main section { padding:78px 0; } .intro-grid,.principles-grid { gap:30px; } .section-heading { display:block; margin-bottom:35px; } .section-heading p { margin-top:22px; } .service-grid,.principles-list,.process-grid,.contact-form { grid-template-columns:1fr; } .service,.service:nth-child(even) { padding:28px 0; border-left:0; } .work-art { min-height:260px; } .work-copy { padding:35px 28px; } .process { padding-bottom:78px; } .process-card h3 { margin-top:25px; } .field-full { grid-column:auto; } .footer-row { align-items:flex-start; flex-direction:column; } .footer-links { flex-wrap:wrap; gap:12px 20px; } } @media (prefers-reduced-motion:reduce) { html { scroll-behavior:auto; } *,*::before,*::after { transition:none !important; } }
		</style>
	</head>
	<body>
		<header class="site-header"><div class="container nav"><a class="brand" href="#top" aria-label="Greenville home"><span class="brand-mark" aria-hidden="true"></span>Greenville</a><nav class="nav-links" aria-label="Primary navigation"><a href="#services">Services</a><a href="#approach">Approach</a><a href="#work">Work</a><a href="#contact">Contact</a></nav><a class="nav-cta" href="#contact">Get a quote <span aria-hidden="true">↗</span></a><button class="menu-button" aria-label="Open navigation">☰</button></div></header>
		<main id="top">
			<section class="hero"><div class="container"><div class="hero-grid"><div><div class="eyebrow">Software · Data · IT</div><h1>Technology built <em>around</em> your business.</h1><p class="hero-copy">Greenville designs and develops practical digital solutions for organizations that need to work smarter, serve people better, and grow with confidence.</p><div class="hero-actions"><a class="button button-primary" href="#contact">Start a conversation <span aria-hidden="true">↗</span></a><a class="button button-secondary" href="#services">Explore services</a></div><div class="hero-note"><span></span> Based in Juja, serving ambitious organizations</div></div></div><div class="signal"><div class="signal-list"><div class="signal-item">01 / Software systems</div><div class="signal-item">02 / Mobile products</div><div class="signal-item">03 / Data services</div><div class="signal-item">04 / IT support</div></div></div></div></section>
			<section class="intro"><div class="container intro-grid"><div><div class="eyebrow">The Greenville approach</div><h2>Make technology useful.</h2></div><div><p>Good technology should make work clearer, faster, and more dependable. We help businesses, schools, NGOs, and growing teams turn operational challenges into digital solutions that people can rely on.</p><p>From the first conversation to long-term support, we keep the work grounded in your goals, your users, and the realities of your organization.</p></div></div></section>
			<section class="services" id="services"><div class="container"><div class="section-heading"><div><div class="eyebrow">What we do</div><h2>Built for the work<br />behind the work.</h2></div><p>Focused capabilities for organizations ready to improve how they operate and connect.</p></div><div class="service-grid">{services.map((service) => <article class="service"><div class="service-number">{service.number}</div><h3>{service.title}</h3><p>{service.description}</p><div class="tags">{service.tags.map((tag) => <span class="tag">{tag}</span>)}</div></article>)}</div></div></section>
			<section class="principles" id="approach"><div class="container principles-grid"><div><div class="eyebrow">Why Greenville</div><h2>Serious about the details that make solutions last.</h2></div><div class="principles-list"><div class="principle"><strong>Business-focused</strong><p>We start with the problem, not the technology. Every build has a clear reason to exist.</p></div><div class="principle"><strong>Security-conscious</strong><p>We treat systems and information with care throughout design, development, and support.</p></div><div class="principle"><strong>Clear communication</strong><p>You should always know what is being built, why it matters, and what happens next.</p></div><div class="principle"><strong>Long-term thinking</strong><p>We build for maintainability and the next stage of your organization, not just launch day.</p></div></div></div></section>
			<section class="work" id="work"><div class="container"><div class="section-heading"><div><div class="eyebrow">Selected work</div><h2>Room for what’s next.</h2></div><p>Our public case studies are growing. In the meantime, explore the kinds of solutions we are equipped to shape with you.</p></div><div class="work-frame"><div class="work-art" aria-label="Abstract illustration representing connected systems" role="img"></div><div class="work-copy"><div class="eyebrow">Capabilities &amp; solutions</div><h3>From idea to dependable system.</h3><p>Whether you are replacing a manual process, launching a customer product, or strengthening day-to-day support, we bring structure to the path forward.</p><a class="work-link" href="#contact">Discuss your project <span aria-hidden="true">↗</span></a></div></div></div></section>
			<section class="process"><div class="container"><div class="section-heading"><div><div class="eyebrow">How we work</div><h2>A clear path<br />forward.</h2></div><p>Good delivery is a shared process. We keep it transparent, considered, and practical.</p></div><div class="process-grid">{process.map(([number, title, description]) => <article class="process-card"><span>{number}</span><h3>{title}</h3><p>{description}</p></article>)}</div></div></section>
			<section class="contact" id="contact"><div class="container contact-grid"><div class="contact-intro"><div class="eyebrow">Start a project</div><h2>Let’s make something useful.</h2><p>Tell us what you are trying to solve. We will get back to you with a clear next step.</p><div class="contact-detail"><strong>Location</strong>Juja, Kiambu County, Kenya</div></div><form class="contact-form" method="post"><div class="field"><label for="name">Name</label><input id="name" name="name" required /></div><div class="field"><label for="organization">Company / organization</label><input id="organization" name="organization" /></div><div class="field"><label for="email">Email</label><input id="email" name="email" type="email" required /></div><div class="field"><label for="service">Service needed</label><select id="service" name="service"><option>Choose a service</option><option>Web applications</option><option>Mobile products</option><option>Data annotation</option><option>IT support</option></select></div><div class="field field-full"><label for="message">What are you working on?</label><textarea id="message" name="message" required></textarea></div><div class="field field-full"><button class="button form-submit" type="submit">Request a quote <span aria-hidden="true">↗</span></button></div></form></div></section>
		</main>
		<footer class="site-footer"><div class="container footer-row"><a class="brand footer-brand" href="#top"><span class="brand-mark" aria-hidden="true"></span>Greenville</a><div>Practical technology for growing organizations.</div><div class="footer-links"><a href="#services">Services</a><a href="#approach">Approach</a><a href="#contact">Contact</a></div></div></footer>
	</body>
</html>
