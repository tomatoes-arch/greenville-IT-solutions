---
import Layout from '../layouts/Layout.astro';
import { projects } from '../data/projects';
---
<Layout title="Work | Greenville IT Solutions" description="Selected web, Android, and digital product work from Greenville.">
	<main><section class="hero"><div class="container"><div class="eyebrow">Live demos</div><h1>Take a closer look at <em>the work.</em></h1><p class="hero-copy">Explore each website, see who it is designed for, and discover the details that make it useful.</p></div></section><section class="demo-section"><div class="container"><div class="demo-list">{projects.map((item) => <article class="demo-card"><a class="demo-visual" href={item.url} target="_blank" rel="noopener noreferrer" aria-label={`Open ${item.title} live demo`}><img src={item.image} alt={item.title} loading="lazy" /><span class="demo-live-label"><span class="live-dot" aria-hidden="true"></span> Open live demo <span aria-hidden="true">↗</span></span></a><div class="demo-copy"><div class="eyebrow">{item.sector}</div><h2>{item.title}</h2><p class="demo-description">{item.text}</p><p class="demo-audience"><strong>Made for</strong>{item.audience}</p><h3>Explore in the demo</h3><ul class="demo-highlights">{item.highlights.map((highlight) => <li>{highlight}</li>)}</ul><div class="case-meta">{item.tags.map((tag) => <span class="tag">{tag}</span>)}</div><a class="button button-dark" href={item.url} target="_blank" rel="noopener noreferrer">Open live demo <span aria-hidden="true">↗</span></a></div></article>)}</div></div></section><section class="cta-band"><div class="container cta-row"><h2>Have a problem like these?</h2><p>Tell us what you are building and where the current process gets stuck.</p><a class="button button-dark" href="/contact/">Start a conversation <span aria-hidden="true">↗</span></a></div></section></main>
</Layout>